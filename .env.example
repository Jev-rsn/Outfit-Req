# ==============================================================================
# OUTFIT REQ — ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu isi nilai rahasia Anda sendiri.
# ==============================================================================

# 1. Supabase Database & Cloud Credentials
# Dapatkan di Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Keamanan & Autentikasi Admin Console
ADMIN_PASSCODE=your_secret_admin_passcode_here
ADMIN_SESSION_SECRET=your_random_session_secret_here

# 3. Kunci API Layanan Eksternal (AI & Scraping)
GEMINI_API_KEY=your_gemini_api_key_here
APIFY_TOKEN=your_apify_api_token_here

# 4. Konfigurasi Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
